SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ACCESS_TOKEN=

# API account — search, match, enrich, track resolve (no playlist writes)
SPOTIFY_API_REFRESH_TOKEN=

# Legacy fallback if SPOTIFY_API_REFRESH_TOKEN is unset
# SPOTIFY_REFRESH_TOKEN=

# Publish accounts — alternate on each new playlist (each may use its own Spotify app)
# Re-auth with scopes: playlist-modify-public playlist-modify-private ugc-image-upload
SPOTIFY_PUBLISH_1_CLIENT_ID=
SPOTIFY_PUBLISH_1_CLIENT_SECRET=
SPOTIFY_PUBLISH_1_REFRESH_TOKEN=
SPOTIFY_PUBLISH_2_CLIENT_ID=
SPOTIFY_PUBLISH_2_CLIENT_SECRET=
SPOTIFY_PUBLISH_2_REFRESH_TOKEN=
GENIUS_ACCESS_TOKEN=
# Genius calendar HTML fetch (Scrapling / Cloudflare on VPS)
GENIUS_FETCH_MODE=auto
GENIUS_FETCH_SOLVE_CLOUDFLARE=1
GENIUS_FETCH_HEADLESS=1
GENIUS_FETCH_TIMEOUT_MS=60000
# Up to 5 residential proxies (failover). Legacy GENIUS_FETCH_PROXY counts as slot 1.
# Example: http://user:pass@host:port
GENIUS_FETCH_PROXY_1=
GENIUS_FETCH_PROXY_2=
GENIUS_FETCH_PROXY_3=
GENIUS_FETCH_PROXY_4=
GENIUS_FETCH_PROXY_5=
# Legacy single-proxy alias (optional if PROXY_1 is set)
# GENIUS_FETCH_PROXY=
# Single SQLite file — album candidates and validation state
DATABASE_URL=sqlite:///data/playlist_builder.db
# AI applied plans (album titles/descriptions after competition gate)
PLAYLIST_AI_QUEUE_DIR=data/ai
# Set to 1 so album publish waits for AI applied plans
PLAYLIST_REQUIRE_AI_PLAN=1
# Default Spotify market for enqueue/publish (DE, GB, ES, ...)
PLAYLIST_MARKET=DE
# Genius scheduler discovers current month plus this many future months (default: 5)
GENIUS_FUTURE_MONTHS=5
# Unified daily pipeline volume + stretch sleeps between Spotify/Codex/setlist calls
DAILY_PUBLISH_CAP=20
DAILY_PUBLISH_FLOOR=5
PIPELINE_STRETCH_SECONDS=2
# Telegram alerts (BotFather token + chat id). Also appends to logs/pipeline-alerts.log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional cap on how far ahead to treat releases as pre-release (days). Omit for no limit.
# PRE_RELEASE_WINDOW_DAYS=
# Emergency brake only — leave unset/high for normal daily pipeline publishing
# ALBUM_PUBLISH_LIMIT=
