{
  "type": "object",
  "properties": {
    "run_date": { "type": "string" },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "event_name": { "type": "string" },
          "event_type": { "type": "string", "const": "tour" },
          "tour_name": { "type": "string" },
          "headliner": { "type": "string" },
          "country": { "type": "string" },
          "city_or_region": { "type": "string" },
          "date_start": { "type": "string" },
          "date_end": { "type": "string" },
          "supporting_artists": { "type": "array", "items": { "type": "string" } },
          "genre_focus": { "type": "array", "items": { "type": "string" } },
          "tour_type": { "type": "array", "items": { "type": "string" } },
          "why_it_matters": { "type": "string" },
          "playlist_angle": { "type": "string" },
          "suggested_playlist_title": { "type": "string" },
          "competition_search_queries": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": { "type": "string" }
          },
          "confidence": { "type": "number" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string" },
                "source_type": {
                  "type": "string",
                  "enum": ["official", "ticketing", "publication", "venue", "promoter"]
                }
              },
              "required": ["title", "url", "source_type"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "event_name",
          "event_type",
          "tour_name",
          "headliner",
          "country",
          "city_or_region",
          "date_start",
          "date_end",
          "supporting_artists",
          "genre_focus",
          "tour_type",
          "why_it_matters",
          "playlist_angle",
          "suggested_playlist_title",
          "competition_search_queries",
          "confidence",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["run_date", "candidates"],
  "additionalProperties": false
}
